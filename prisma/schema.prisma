generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  username         String   @unique
  bio              String?
  profileImage     String?
  coverImage       String?
  passwordHash     String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  posts            Post[]
  followers        Follow[] @relation("followers")
  following        Follow[] @relation("followings")
}

model Follow {
  follower_id  String
  following_id String
  createdAt    DateTime @default(now())

  follower User @relation("followings", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
}

model Post {
  id            String    @id @default(cuid())
  content       String
  authorName    String
  authorEmail   String?
  imageUrls     String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  comments      Comment[]
  user          User?     @relation(fields: [authorEmail], references: [email])
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id                String   @id
  title             String?
  description       String?
  content           String?
  image             String?
  source            String?
  author            String?
  published_at      DateTime?
  category          String?
  country           String?
  url               String?  @unique
  summary           String?
  tldr              String?
  seo_title         String?
  meta_description  String?
  keywords          String[] @default([])
  tags              String[] @default([])
  suggested_category String?
  social_caption    String?
  imported_at       DateTime @default(now())
  published         Boolean  @default(false)
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  metadata   Json?
  created_at DateTime @default(now())
}
